# Copiar a deployment.env (ignorado por Git). Azure Cloud Shell, Bash.
# Identificador de la suscripción del equipo, nunca un token ni una contraseña.
export CAFENUBE_SUBSCRIPTION_ID=''
export CAFENUBE_DNS_LABEL='cafenube-ventas-publica'
export CAFENUBE_VM_SIZE='Standard_B2ats_v2'
# Clave pública existente; la clave privada nunca se copia al repositorio.
export CAFENUBE_SSH_PUBLIC_KEY="$HOME/.ssh/cafenube.pub"
