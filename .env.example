# Clave de la API de Gemini (Google AI Studio). Obtén una gratis en:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional. Modelo de Gemini a usar (default: gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# Opcional. Carpeta que expone el Filesystem MCP server (default: ./workspace)
# WORKSPACE_DIR=./workspace

# Opcional. URL del servidor car_rental remoto (Cloud Run/etc). Si se define,
# el chatbot lo usa en vez del servidor local por stdio.
# CAR_RENTAL_REMOTE_URL=https://your-cloud-run-url
